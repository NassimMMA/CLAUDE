<!-- DEVIS -->
<section id="devis" class="devis">
  <div class="wrap">
    <div class="devis-layout">
      <div class="devis-intro">
        <h2>Demander un devis</h2>
        <p>Restaurant, hôtel, traiteur, épicerie fine, distributeur ou grossiste : parlez-nous de votre établissement, nous revenons vers vous rapidement.</p>
        <div class="devis-contact">
          <a href="tel:+33612637976">06 12 63 79 76</a>
          <a href="mailto:nassim@maquispro.com">nassim@maquispro.com</a>
        </div>
      </div>

      <form class="quote-form" id="quote-form" novalidate>
        <div class="field">
          <label for="f-nom">Nom</label>
          <input type="text" id="f-nom" name="nom" autocomplete="name" required>
        </div>
        <div class="field">
          <label for="f-societe">Société</label>
          <input type="text" id="f-societe" name="societe" autocomplete="organization" required>
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input type="email" id="f-email" name="email" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="f-tel">Téléphone</label>
          <input type="tel" id="f-tel" name="telephone" autocomplete="tel" required>
        </div>
        <div class="field full">
          <label for="f-type">Type d'établissement</label>
          <select id="f-type" name="type" required>
            <option value="" disabled selected>Sélectionnez une option</option>
            <option value="restaurant">Restaurant</option>
            <option value="hotel">Hôtel</option>
            <option value="traiteur">Traiteur</option>
            <option value="epicerie">Épicerie fine</option>
            <option value="distributeur">Distributeur</option>
            <option value="grossiste">Grossiste</option>
            <option value="autre">Autre</option>
          </select>
        </div>
        <div class="field full">
          <label for="f-message">Message</label>
          <textarea id="f-message" name="message" placeholder="Vos besoins, volumes envisagés, producteurs qui vous intéressent…"></textarea>
        </div>
        <p class="form-note">Champs marqués nécessaires pour vous recontacter. Vos données ne sont utilisées que pour traiter votre demande.</p>
        <div class="form-submit">
          <button type="submit" class="btn btn-primary">Envoyer la demande</button>
          <span class="form-status" id="form-status" role="status" aria-live="polite"></span>
        </div>
      </form>
    </div>
  </div>
</section>
